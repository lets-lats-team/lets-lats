# 실행에 필요한 환경 변수 이름만 적는다. 실제 값은 .env에 넣고 커밋하지 않는다.

# 로컬 Compose (deploy/docker-compose.yml)
# POSTGRES_*는 로컬 DB 컨테이너를 처음 만들 때만 쓴다. 앱의 접속 변수는 각 기능에서 더한다
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# MinIO: 사용자 3자 이상, 비밀번호 8자 이상. 접속 주소에 들어가므로 영문과 숫자만 쓴다
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 버킷 이름: 영문 소문자, 숫자, 하이픈 3~63자. 처음과 끝은 영문 소문자나 숫자 (예: latser-dev)
S3_BUCKET=

# 앱과 워커 (값을 처음 쓰는 기능에서 채운다)
DATABASE_URL=
AWS_REGION=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
